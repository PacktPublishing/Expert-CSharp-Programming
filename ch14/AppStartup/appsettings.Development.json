{
  // appsettings.Development.json — overrides applied only when
  // ASPNETCORE_ENVIRONMENT=Development (or DOTNET_ENVIRONMENT=Development).
  // These values are layered on top of appsettings.json at startup.
  "AppOptions": {
    "Name": "AppStartupSample (Dev)",
    "MaxItems": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
