{
  // appsettings.json — baseline configuration for all environments.
  // Each environment can override any value via appsettings.{Environment}.json,
  // environment variables, or command-line arguments (higher priority wins).
  "AppOptions": {
    "Name": "AppStartupSample",
    "Version": "1.0.0",
    "MaxItems": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
