{
  // appsettings.Development.json — overrides applied only when
  // DOTNET_ENVIRONMENT=Development (the default for `dotnet run`).
  // Only specify keys that differ from the baseline in appsettings.json.
  "Database": {
    "ConnectionString": "Server=localhost;Database=myapp_dev;Integrated Security=true;",
    "CommandTimeoutSeconds": 60
  },

  "FeatureFlags": {
    "EnableBetaFeatures": true,
    "MaxUploadSizeMb": 100
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  }
}
