{
  // appsettings.json — logging configuration for the built-in providers.
  // Serilog reads its own configuration from the "Serilog" section (optional);
  // here we demonstrate the "Logging" section used by Microsoft.Extensions.Logging.
  "Logging": {
    "LogLevel": {
      // Default minimum level — applies to all categories not listed below
      "Default": "Debug",
      // Reduce noisy framework output
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning",
      // Our own code can be more verbose
      "OrderService": "Debug",
      "PaymentService": "Information"
    },
    "Console": {
      "LogLevel": {
        "OrderService": "Information"
      },
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true,
        "JsonWriterOptions": {
          "Indented": true
        }
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} — {Message:lj}{NewLine}{Exception}",
          "formatProvider": "System.Globalization.CultureInfo::InvariantCulture"
        }
      }
    ]
  }
}
